# Copy to .env and adjust for your environment.
# The .env file is read by pydantic-settings at startup.

APP_NAME="Bookshelf API"
DEBUG=false

# SQLAlchemy connection string.
# Local (host machine) default:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bookshelf

# When running via docker compose, the host is the service name "db":
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/bookshelf